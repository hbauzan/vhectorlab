# VectorLab 3D - Environment Variables
HOST=127.0.0.1
PORT=8000
MODEL_NAME=all-mpnet-base-v2
VOCAB_PATH=public/vocab.txt
LOG_LEVEL=INFO

# Frontend (Vite) — show live camera POS/ROT overlay for capturing default views
VITE_SHOW_CAM_POSE=false

# Optional API base. Leave unset for auto:
#   localhost → http://127.0.0.1:8000
#   ngrok/public host → /api (Vite proxies to :8000; only tunnel the frontend :5173)
# Dual-tunnel (two different ngrok URLs): set this to the backend public URL, e.g.
#   VITE_API_BASE_URL=https://<backend-subdomain>.ngrok-free.dev
# VITE_API_BASE_URL=
